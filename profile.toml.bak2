# ── Indiana / midwest presence ─────────────────────────────────────────
[[boards]]
source = "greenhouse"
token  = "salesforce"

[[boards]]
source = "ashby"
token  = "angi"

[signals]
# Opt-in adjustments from what a posting reveals about itself. Absent = 0, so
# removing this section restores the original ranking exactly.
#
# Weighted for someone who is strong on judgment and design and weaker on a
# timed algorithm screen. Change the numbers when that stops being true.
interview_take_home    =  8
interview_pairing      =  8
interview_no_leetcode  =  6
interview_system_design =  4
interview_live_coding  = -6

ai_encouraged          =  8
ai_mentioned           =  3
ai_prohibited          = -10

friction_low           =  3
friction_high          = -4

# Preference, not a requirement — nothing is ever disqualified on comp, and a
# posting below the preference is simply not rewarded rather than punished.
comp_floor             = 80      # thousands
comp_meets_floor       =  4
comp_below_floor       =  0
